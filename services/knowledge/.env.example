# Local CLI configuration. Copy to .env, keep it private, and leave unused values empty.
# CLI commands load .env automatically; exported environment variables take precedence.
KNOWLEDGE_PUBLIC_MCP_URL=
KNOWLEDGE_EDITOR_MCP_URL=
KNOWLEDGE_PUBLIC_API_URL=

# Privileged editor token for upload/diagnostics. Never use it in the website build.
KNOWLEDGE_EDITOR_ACCESS_TOKEN=

# Optional local PDF parser, with requirements-pdf.txt installed.
KNOWLEDGE_PYTHON=python3

# Actual public Worker's bucket-scoped Object Read credentials, only for the explicit probe.
PUBLISHED_S3_ENDPOINT=
PUBLISHED_BUCKET_NAME=
PUBLISHED_READ_ACCESS_KEY_ID=
PUBLISHED_READ_SECRET_ACCESS_KEY=
PRIVATE_PROBE_BUCKET=
PRIVATE_PROBE_KEY=
