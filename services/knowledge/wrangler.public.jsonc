{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uclai-knowledge-public-staging",
  "main": "src/public-worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://PUBLIC_HOST_REQUIRED",
    "ALLOWED_ORIGINS": "https://uclai.co.uk,https://chatgpt.com,https://claude.ai",
    "PUBLISHED_S3_ENDPOINT": "https://ACCOUNT_ID_REQUIRED.r2.cloudflarestorage.com",
    "PUBLISHED_BUCKET_NAME": "uclai-knowledge-published-staging"
  },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": false }
}
